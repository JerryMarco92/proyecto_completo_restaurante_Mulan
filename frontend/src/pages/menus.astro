---
import Layout from "../layouts/Layout.astro";
import "../styles/estilosPlatoCard.css";
import "../styles/menus.css";
---

<Layout title="Menús | Restaurante Mulan">

  <section class="menus">

    <h1 class="menus__titulo">
      Menús
    </h1>

    <div class="menus__lista">

      <article class="card menu-card">

        <h3 class="menu-card__titulo">
          Menú de 2 personas
        </h3>

        <ul class="menu-card__lista">

          <li class="menu-card__plato">
            Rollitos de primavera <br>(2 raciones)
          </li>

          <li class="menu-card__plato">
            Ensalada de la casa
          </li>

          <li class="menu-card__plato">
            Arroz 3 delicias
          </li>

          <li class="menu-card__plato">
            Ternera con salsa de ostras
          </li>

          <li class="menu-card__plato">
            Bolas de pollo fritas
          </li>

        </ul>

        <p class="card__price">
          <strong>27.50 €</strong>
        </p>

      </article>


      <article class="card menu-card">

        <h3 class="menu-card__titulo">
          Menú de 3 personas
        </h3>

        <ul class="menu-card__lista">

          <li class="menu-card__plato">
            Rollitos de primavera <br>(3 raciones)
          </li>

          <li class="menu-card__plato">
            Ensalada de la casa
          </li>

          <li class="menu-card__plato">
            Won ton frito
          </li>

          <li class="menu-card__plato">
            Arroz 3 delicias
          </li>

          <li class="menu-card__plato">
            Ternera con salsa de ostras
          </li>

          <li class="menu-card__plato">
            Pollo al limón
          </li>

          <li class="menu-card__plato">
            Lomo asado Bamingaban
          </li>

        </ul>

        <p class="card__price">
          <strong>41.50 €</strong>
        </p>

      </article>

      <article class="card menu-card">

        <h3 class="menu-card__titulo">
          Menú de 4 personas
        </h3>

        <ul class="menu-card__lista">

          <li class="menu-card__plato">
            Rollitos de primavera <br>(4 raciones)
          </li>

          <li class="menu-card__plato">
            Ensalada de la casa
          </li>

          <li class="menu-card__plato">
            Won-ton frito
          </li>

          <li class="menu-card__plato">
            Arroz 3 delicias (2)
          </li>

          <li class="menu-card__plato">
            Ternera con salsa de ostras
          </li>

          <li class="menu-card__plato">
            Pollo con almendras
          </li>

          <li class="menu-card__plato">
            Cerdo agridulce
          </li>

          <li class="menu-card__plato">
            Bolas de pollo frito
          </li>

        </ul>

        <p class="card__price">
          <strong>54.95 €</strong>
        </p>

      </article>


      <article class="card menu-card">

        <h3 class="menu-card__titulo">
          Menú de 5 personas
        </h3>

        <ul class="menu-card__lista">

          <li class="menu-card__plato">
            Rollitos de primavera <br>(5 raciones)
          </li>

          <li class="menu-card__plato">
            Ensalada de la casa (2)
          </li>

          <li class="menu-card__plato">
            Won ton frito (2)
          </li>

          <li class="menu-card__plato">
            Arroz 3 delicias (2)
          </li>

          <li class="menu-card__plato">
            Ternera con salsa de ostras
          </li>

          <li class="menu-card__plato">
            Pollo con almendras
          </li>

          <li class="menu-card__plato">
            Cerdo agridulce
          </li>

          <li class="menu-card__plato">
            Bolas de pollo frito
          </li>

          <li class="menu-card__plato">
            Pato a la naranja
          </li>

        </ul>

        <p class="card__price">
          <strong>68.95 €</strong>
        </p>

      </article>

    </div>

  </section>

</Layout>
