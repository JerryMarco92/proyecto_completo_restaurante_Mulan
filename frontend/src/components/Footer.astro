---
import "../styles/footer.css";
---

<footer class="footer">
    <div class="footer__container">

        <div class="footer__section footer__section--schedule">
            <h2 class="footer__title">Horario</h2>

            <div class="footer__schedule">
                <span class="footer__icon footer__icon--schedule" aria-hidden="true"></span>

                <dl class="footer__schedule-list">
                    <div class="footer__schedule-item">
                        <dt class="footer__schedule-day">Lunes - Miercoles - Jueves</dt>
                        <dd class="footer__schedule-hours">12:15 - 16:15</dd>
                        <dd class="footer__schedule-hours">19:45 - 23:15</dd>
                    </div>

                    <div class="footer__schedule-item">
                        <dt class="footer__schedule-day">Viernes - Sabado - Domingo</dt>
                        <dd class="footer__schedule-hours">11:45 - 16:15</dd>
                        <dd class="footer__schedule-hours">19:45 - 23:15</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="footer__section footer__section--contact">
            <h2 class="footer__title">Contacto</h2>

            <address class="footer__contact">
                <div class="footer__contact-item">
                    <span class="footer__icon footer__icon--phone" aria-hidden="true"></span>

                    <div class="footer__phones">
                        <a
                            class="footer__phone"
                            href="tel:962414871"
                            aria-label="Llamar al 962414871"
                        >
                            962 414 871
                        </a>

                        <a
                            class="footer__phone"
                            href="tel:962414969"
                            aria-label="Llamar al 962414969"
                        >
                            962 414 969
                        </a>
                    </div>
                </div>
            </address>
        </div>

    </div>

    <div class="footer__bottom">
        <p class="footer__copyright">
            &copy; <span class="footer__copyright-name">Jerome</span>.
            Todos los derechos reservados.
        </p>
    </div>
</footer>